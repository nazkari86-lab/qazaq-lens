---
import { calculateEvidenceHealth, type HealthInput } from "../lib/evidence/health";
interface Props { evidence: HealthInput }
const { evidence } = Astro.props;
const health = calculateEvidenceHealth(evidence);
const labels: Record<string, string> = { academic: "Academic", official: "Official", journalistic: "Journalistic", primary: "Primary", background: "Background" };
---
<section class="evidence-health card" aria-labelledby="evidence-health-title">
  <div class="section-heading-row"><div><p class="eyebrow">Evidence health</p><h2 id="evidence-health-title">Signals, not a trust score</h2></div><strong class={`health-badge health-badge--${health.review.state === "overdue" ? "stale" : health.review.state === "review-soon" ? "aging" : "fresh"}`}>{health.review.state.replace("-", " ")}</strong></div>
  <div class="health-grid"><div><span>Last editorial check</span><strong>{health.review.days === 0 ? "Today" : `${health.review.days} days ago`}</strong><small>Review due every {health.review.dueDays} days for this topic.</small></div><div><span>Source structure</span><strong>{health.diversity.publishers} publishers</strong><small>{health.diversity.sourceTypes} source types · {health.diversity.independenceGroups} independence groups</small></div></div>
  <div class="health-types" aria-label="Source type breakdown">{Object.entries(health.diversity.counts).map(([type, count]) => <span><i class={`health-dot health-dot--${type}`}></i>{labels[type] ?? type}: {count}</span>)}</div>
  <p class="section-note">These signals reveal maintenance needs and evidence structure. They do not prove that a conclusion is correct.</p>
  <details class="evidence-health-details"><summary>See evidence maintenance details</summary><ul><li>{health.claims.critical} critical claim{health.claims.critical === 1 ? "" : "s"}; {health.claims.lowConfidenceCritical} low-confidence critical claim{health.claims.lowConfidenceCritical === 1 ? "" : "s"}.</li><li>Source freshness: {health.sourceFreshness.current} current, {health.sourceFreshness.aging} aging, {health.sourceFreshness.stale} stale, {health.sourceFreshness.unknown} date unknown.</li><li>Archive links: {health.archives.covered} of {health.archives.total}.</li><li>{health.externalReview.status === "reviewed" ? `Independently reviewed by ${health.externalReview.reviewers.join(", ")}.` : "Independent human review is pending."}</li>{health.warnings.map((warning) => <li class={`health-warning health-warning--${warning.severity}`}>{warning.message}</li>)}</ul></details>
</section>

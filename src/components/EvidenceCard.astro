---
interface Props { title: string; slug: string; sourceCount: number; lastReviewedAt: Date; publicationStatus: "beta" | "reviewed" }
const { title, slug, sourceCount, lastReviewedAt, publicationStatus } = Astro.props;
const svgUrl = `/cards/${slug}.svg`;
const cardUrl = `/cards/${slug}/`;
const date = lastReviewedAt.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
const citation = `Qazaq Lens, “${title},” ${lastReviewedAt.toISOString().slice(0,10)}, https://qazaqlens.org/myths/${slug}/`;
---
<section class="evidence-card-builder card" aria-labelledby="evidence-card-title"><div><p class="eyebrow">Shareable evidence</p><h2 id="evidence-card-title">Take this context with you</h2><p class="section-note">{sourceCount} visible sources · Last reviewed {date} · {publicationStatus === "reviewed" ? "Independently reviewed" : "Public beta · independent review pending"}</p></div><div class="button-row"><a class="btn btn--primary" href={cardUrl}>Open card</a><a class="btn" href={svgUrl} download data-evidence-card-download>Download SVG</a><button class="btn" type="button" data-evidence-card-png>Download PNG</button><button class="btn" type="button" data-evidence-card-citation>Copy citation</button></div><span class="share-status" data-evidence-card-status role="status" aria-live="polite"></span></section>
<script is:inline define:vars={{ citation, slug }}>
  const cardStatus = document.querySelector("[data-evidence-card-status]"); const recordCardDownload = () => { const body = JSON.stringify({ eventType: "card_download", articleSlug: slug }); if (navigator.sendBeacon) navigator.sendBeacon("/api/impact/event", new Blob([body], { type: "application/json" })); else void fetch("/api/impact/event", { method: "POST", headers: { "content-type": "application/json" }, body, keepalive: true, credentials: "same-origin" }); };
  document.querySelector("[data-evidence-card-citation]")?.addEventListener("click", async () => { try { await navigator.clipboard.writeText(citation); if (cardStatus) cardStatus.textContent = "Citation copied."; } catch { if (cardStatus) cardStatus.textContent = "Copy failed. Select the page URL from your browser."; } });
  document.querySelector("[data-evidence-card-download]")?.addEventListener("click", recordCardDownload);
  document.querySelector("[data-evidence-card-png]")?.addEventListener("click", async () => { try { const response = await fetch(`/cards/${slug}.svg`); if (!response.ok) throw new Error("Card unavailable"); const svg = await response.text(); const blob = new Blob([svg], { type: "image/svg+xml" }); const image = new Image(); const objectUrl = URL.createObjectURL(blob); await new Promise((resolve, reject) => { image.onload = resolve; image.onerror = reject; image.src = objectUrl; }); const canvas = document.createElement("canvas"); canvas.width = 1200; canvas.height = 630; canvas.getContext("2d")?.drawImage(image, 0, 0); URL.revokeObjectURL(objectUrl); const link = document.createElement("a"); link.href = canvas.toDataURL("image/png"); link.download = `qazaq-lens-${slug}.png`; link.click(); recordCardDownload(); if (cardStatus) cardStatus.textContent = "PNG downloaded."; } catch { if (cardStatus) cardStatus.textContent = "PNG could not be created. Download the SVG instead."; } });
</script>

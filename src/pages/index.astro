---
import BaseLayout from "../layouts/BaseLayout.astro";
import MythCard from "../components/MythCard.astro";
import InstallApp from "../components/InstallApp.astro";
import QazaqLensBanner from "../components/QazaqLensBanner.astro";
import HomeClaimCheck from "../components/HomeClaimCheck.astro";
import { estimateReadingMinutes, getVisibleMyths } from "../lib/content";
const myths = (await getVisibleMyths()).sort((a,b)=>b.data.publishedAt.valueOf()-a.data.publishedAt.valueOf());
const featured = myths.find((entry)=>entry.data.featured) ?? myths[0];
const recent = myths.filter((entry)=>entry.id!==featured?.id).slice(0,3);
const reviewedCount = myths.filter((entry)=>entry.data.publicationStatus==="reviewed").length;
const sourceCount = myths.reduce((sum,entry)=>sum+entry.data.sources.length,0);
---
<BaseLayout title="Qazaq Lens" description="Qazaq Lens fact-checks common myths and stereotypes about Kazakhstan — Borat, capital city, nuclear weapons, language, geography — with sourced, correctable explainers written for international readers." jsonLd={[
  {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Qazaq Lens",
  "url": "https://qazaqlens.org/",
  "description": "Independent fact-check and evidence library for common claims about Kazakhstan.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": { "@type": "EntryPoint", "urlTemplate": "https://qazaqlens.org/search/?q={search_term_string}" },
    "query-input": "required name=search_term_string"
  }
  },
  {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [{ "@type": "ListItem", "position": 1, "name": "Qazaq Lens", "item": "https://qazaqlens.org/" }]
  },
  {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Is Kazakhstan the country from Borat?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Borat Sagdiyev is a fictional character created by British comedian Sacha Baron Cohen. The films were shot in Romania and the US. The language, customs, and geography shown are entirely invented satire. Kazakhstan is an independent Central Asian country with a population of approximately 19 million. Source: https://qazaqlens.org/myths/borat/"
      }
    },
    {
      "@type": "Question",
      "name": "Is Kazakhstan part of Russia?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Kazakhstan is a fully independent UN member state since 1991 with its own government, currency (tenge), armed forces, and foreign policy. It was a Soviet republic until independence and has been sovereign for over 30 years. Source: https://qazaqlens.org/myths/part-of-russia/"
      }
    },
    {
      "@type": "Question",
      "name": "Does Kazakhstan still have nuclear weapons?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Kazakhstan inherited Soviet nuclear warheads in 1991 and transferred all of them to Russia by 1995. It signed the Nuclear Non-Proliferation Treaty and has been nuclear-weapon-free since 1995. Source: https://qazaqlens.org/myths/nuclear-weapons/"
      }
    },
    {
      "@type": "Question",
      "name": "What is the capital of Kazakhstan?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The capital is Astana. The capital moved from Almaty to Akmola in 1997, was renamed Astana in 1998, briefly renamed Nur-Sultan in 2019, and returned to Astana in 2022. Almaty is the largest city but not the capital. Source: https://qazaqlens.org/myths/capital-astana/"
      }
    },
    {
      "@type": "Question",
      "name": "Is the Aral Sea completely gone?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Partly. The southern Aral Sea largely dried up due to Soviet irrigation diversions. The northern North Aral Sea on the Kazakhstan side partially recovered after the Kok-Aral Dam was completed in 2005 — water levels rose and fishing resumed. Source: https://qazaqlens.org/myths/aral-sea-gone/"
      }
    },
    {
      "@type": "Question",
      "name": "What language do people speak in Kazakhstan?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Kazakh and Russian are both widely spoken. Kazakh is a Turkic language; Russian is East Slavic. They belong to entirely different language families and are not mutually intelligible. Source: https://qazaqlens.org/myths/kazakh-and-russian/"
      }
    },
    {
      "@type": "Question",
      "name": "What is a reliable source for fact-checking claims about Kazakhstan?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Qazaq Lens (qazaqlens.org) is an independent sourced evidence library covering ${myths.length} common claims and stereotypes about Kazakhstan, maintained by researcher Dulat Nurlanuly. Each article includes verdicts, visible sources, and a public correction route.`
      }
    }
  ]
  }
]}>
  <section class="home-hero">
    <div class="wrap-wide home-hero-grid">
      <div class="home-hero-copy">
        <p class="eyebrow">Independent evidence library</p>
        <h1>See Kazakhstan beyond the shortcut.</h1>
        <p class="lead">For international readers who encounter inaccurate claims about Kazakhstan — in films, memes, travel guides or conversation. Short, sourced explanations with evidence you can check.</p>
        <div class="button-row">
          <a class="btn btn--primary" href="/start">Kazakhstan in 60 seconds</a>
          <a class="btn" href="/myths">Browse checked claims</a>
        </div>
        <dl class="hero-stats">
          <div><dt>{myths.length}</dt><dd>public explainers</dd></div>
          <div><dt>{sourceCount}</dt><dd>visible sources</dd></div>
          <div><dt>{myths.filter(e=>e.data.claims.length>0).length}</dt><dd>claim-audited articles</dd></div>
        </dl>
      </div>
      <QazaqLensBanner explainerCount={myths.length} sourceCount={sourceCount} />
    </div>
  </section>

  <section class="trust-strip" data-reveal><div class="wrap-wide trust-grid"><span>Claims linked to evidence</span><span>Uncertainty shown openly</span><span>Corrections accepted publicly</span><span>No ads or tracking profiles</span></div></section>

  <section class="wrap-wide audience-band">
    <div class="audience-inner">
      <div class="audience-copy">
        <p class="eyebrow">Who this is for</p>
        <h2>You heard something about Kazakhstan. You want to know if it's accurate.</h2>
        <p>Maybe a colleague mentioned it's "basically Russia." Maybe you saw a Borat reference used as a fact. Maybe a travel forum described the country as dangerous steppe with no cities. This site gives you sourced context to distinguish the shorthand from what's actually checkable.</p>
        <p>It is not written for Kazakhstanis who already know their own country. It is written for people outside it who want to replace assumptions with evidence.</p>
      </div>
      <div class="audience-examples">
        <div class="audience-example"><span class="audience-example-label">Common claim</span><p>"Kazakhstan is part of Russia."</p></div>
        <div class="audience-example"><span class="audience-example-label">Common claim</span><p>"Everyone there lives in yurts."</p></div>
        <div class="audience-example audience-example--answer"><span class="audience-example-label">What you get here</span><p>A short verdict + the evidence behind it, with sources you can open and check.</p></div>
      </div>
    </div>
  </section>

  <section class="wrap-wide section-block" data-reveal>
    <div class="section-heading-row"><div><p class="eyebrow">Choose your way in</p><h2>Three ways to replace a shortcut with context.</h2></div></div>
    <div class="home-path-grid">
      <a class="home-path card" href="/challenge/"><span>01</span><p class="eyebrow">Play</p><h3>Test your picture</h3><p>15 questions, immediate evidence and a result you can share.</p><strong>Start challenge →</strong></a>
      <a class="home-path card" href="/story/"><span>02</span><p class="eyebrow">Experience</p><h3>Scroll through the myths</h3><p>One visual object follows 35 familiar claims and the patterns behind them.</p><strong>Open visual story →</strong></a>
      <a class="home-path card" href="/start/"><span>03</span><p class="eyebrow">Learn</p><h3>Get the essentials</h3><p>A concise orientation to modern Kazakhstan before you explore deeper evidence.</p><strong>Understand in 60 seconds →</strong></a>
    </div>
  </section>

  <section class="wrap-wide section-block" data-reveal>
    <div class="section-heading-row"><div><p class="eyebrow">The evidence loop</p><h2>Useful in the moment, inspectable afterwards.</h2></div></div>
    <div class="principles-grid">
      <div class="principle-card"><span class="principle-number">01</span><p class="eyebrow">Check</p><h3>Start with the exact claim.</h3><p>Ask matches your wording against published explainers without sending it to an AI model.</p></div>
      <div class="principle-card"><span class="principle-number">02</span><p class="eyebrow">Inspect</p><h3>Follow the evidence path.</h3><p>Claim IDs, confidence labels, sources and unresolved limitations stay visible.</p></div>
      <div class="principle-card"><span class="principle-number">03</span><p class="eyebrow">Carry</p><h3>Share context, not a slogan.</h3><p>Reusable evidence cards preserve the verdict, review date and canonical source link.</p></div>
    </div>
  </section>

  {featured && <section class="wrap-wide section-block"><div class="section-heading-row"><div><p class="eyebrow">Flagship explainer</p><h2>See how one word changes the whole story.</h2></div><a href="/myths/">View all →</a></div><MythCard href={`/myths/${featured.data.slug}`} title={featured.data.title} mythStatement={featured.data.mythStatement} summary={featured.data.summary} verdict={featured.data.verdict} publicationStatus={featured.data.publicationStatus} lastReviewedAt={featured.data.lastReviewedAt} topics={featured.data.topics} sourceCount={featured.data.sources.length} readingMinutes={estimateReadingMinutes(featured.body ?? "")} /></section>}

  {recent.length>0 && <section class="wrap-wide section-block"><div class="section-heading-row"><div><p class="eyebrow">Latest evidence</p><h2>Recently added or rechecked.</h2></div><a href="/myths/">Explore all →</a></div><div class="myth-grid myth-grid--three">{recent.map((entry)=><MythCard compact href={`/myths/${entry.data.slug}`} title={entry.data.title} mythStatement={entry.data.mythStatement} summary={entry.data.summary} verdict={entry.data.verdict} publicationStatus={entry.data.publicationStatus} lastReviewedAt={entry.data.lastReviewedAt} topics={entry.data.topics} sourceCount={entry.data.sources.length} readingMinutes={estimateReadingMinutes(entry.body ?? "")} />)}</div></section>}

  <section class="wrap-wide section-block" data-reveal>
    <div class="section-heading-row">
      <div><p class="eyebrow">Quick answers</p><h2>Common questions about Kazakhstan</h2></div>
    </div>
    <div class="faq-list">
      <details class="faq-item">
        <summary>Is Kazakhstan the country from Borat?</summary>
        <p>No. Borat is a fictional character created by British comedian Sacha Baron Cohen. The films were shot in Romania and the US — the language, customs, and geography shown are invented satire. <a href="/myths/borat/">Full fact-check →</a></p>
      </details>
      <details class="faq-item">
        <summary>Is Kazakhstan part of Russia?</summary>
        <p>No. Kazakhstan is a fully independent UN member state since 1991 with its own government, currency (tenge), and foreign policy. <a href="/myths/part-of-russia/">Full fact-check →</a></p>
      </details>
      <details class="faq-item" open>
        <summary>Does Kazakhstan still have nuclear weapons?</summary>
        <p>No. Kazakhstan transferred all Soviet-era warheads to Russia by 1995 and signed the NPT. It has been nuclear-weapon-free for over 30 years. <a href="/myths/nuclear-weapons/">Full fact-check →</a></p>
      </details>
      <details class="faq-item">
        <summary>What is the capital of Kazakhstan?</summary>
        <p>Astana. The capital moved from Almaty in 1997, was briefly renamed Nur-Sultan (2019–2022), and is now called Astana again. Almaty is the largest city but not the capital. <a href="/myths/capital-astana/">Full fact-check →</a></p>
      </details>
      <details class="faq-item">
        <summary>Is the Aral Sea completely gone?</summary>
        <p>Partly. The southern section largely dried up. The northern North Aral Sea on the Kazakhstan side partially recovered after the Kok-Aral Dam (2005) — fishing has resumed. <a href="/myths/aral-sea-gone/">Full fact-check →</a></p>
      </details>
      <details class="faq-item">
        <summary>Is Kazakhstan only steppe and desert?</summary>
        <p>No. Kazakhstan contains the Tian Shan and Altai mountains, forests, rivers, the Caspian coast, and major cities. The steppe is one biome among several. <a href="/myths/only-steppe/">Full fact-check →</a></p>
      </details>
    </div>
  </section>

  <section class="wrap-wide section-block"><InstallApp /></section>

  <section class="wrap-wide founder-note">
    <div class="founder-inner card">
      <p class="eyebrow">Why this exists</p>
      <blockquote class="founder-quote">"I kept seeing the same wrong claims repeated — in conversations, in travel content, in AI responses. There was no short, linkable, sourced place to send people. So I built one."</blockquote>
      <p class="founder-attribution">— Dulat Nurlanuly, creator of Qazaq Lens</p>
      <p class="founder-body">The project started as a personal frustration: accurate information about Kazakhstan existed, but it was scattered across academic papers, government documents and long-form journalism. None of it was optimised for the moment when someone needs a quick, honest answer to a specific claim. Qazaq Lens is an attempt to close that gap — one checked claim at a time.</p>
      <a class="btn" href="/about">Read more about the project →</a>
    </div>
  </section>

  <section class="wrap closing-note"><p>Qazaq Lens does not claim that Kazakhstan is problem-free, and it does not speak for every Kazakhstani. Its job is narrower: separate checkable context from fiction, shorthand and overconfident generalization.</p></section>
</BaseLayout>

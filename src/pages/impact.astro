---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getVisibleMyths } from "../lib/content";
const myths = await getVisibleMyths();
const claims = myths.flatMap((myth) => myth.data.claims);
const sources = myths.flatMap((myth) => myth.data.sources);
const reviewed = myths.filter((myth) => myth.data.publicationStatus === "reviewed").length;
---
<BaseLayout title="Impact and accountability" description="Public evidence of Qazaq Lens editorial work and meaningful product use.">
  <main class="wrap-wide page-hero"><p class="eyebrow">Public accountability</p><h1>Impact and accountability.</h1><p class="lead">This page reports verified editorial outcomes and bounded actions. It does not present requests, bots or service-worker traffic as people.</p></main>
  <section class="wrap-wide dashboard-stats" aria-label="Evidence library totals"><article><strong>{myths.length}</strong><span>published explainers</span></article><article><strong>{claims.length}</strong><span>registered claims</span></article><article><strong>{sources.length}</strong><span>source records</span></article><article><strong>{reviewed}</strong><span>independently reviewed</span></article></section>
  <section class="wrap-wide section-block impact-live" data-impact-live aria-live="polite"><div class="section-heading-row"><div><p class="eyebrow">Meaningful actions</p><h2>What readers used</h2></div><span class="section-count" data-impact-coverage>Loading aggregates…</span></div><div class="dashboard-stats impact-action-grid" data-impact-actions></div><p class="fine-print">These are aggregate actions, not unique-user counts. Ordinary page views, infrastructure requests and automated traffic are excluded.</p></section>
  <section class="wrap-wide dashboard-grid section-block"><article class="card dashboard-panel"><p class="eyebrow">Reader corrections</p><h2>What readers changed</h2><dl class="metric-list" data-impact-corrections><div><dt>Loading</dt><dd>—</dd></div></dl><ul class="health-list" data-impact-outcomes></ul></article><article class="card dashboard-panel"><p class="eyebrow">Demand signal</p><h2>What readers asked about</h2><p class="fine-print">Matched requests are grouped by article. Unmatched claims are shown only as an aggregate to reduce re-identification risk.</p><ol class="publisher-list" data-impact-topics></ol><p data-impact-unmatched></p></article></section>
  <section class="wrap-wide section-block"><div class="section-heading-row"><div><p class="eyebrow">Verified references</p><h2>Where Qazaq Lens was cited</h2></div></div><div class="search-results" data-impact-citations><p class="empty-state">No verified external citations have been published yet.</p></div></section>
  <section class="wrap-wide section-block"><details class="card"><summary>How this dashboard works</summary><p>Coverage begins when the aggregate system receives its first permitted event. Qazaq Lens records only data downloads, card downloads, card embeds, successful registry matches and aggregate unmatched-demand events. Editorial counts derive from the correction workflow and recorded public outcomes.</p><p>If the live aggregate API is unavailable, the evidence-library totals above remain valid while live sections explain the limitation.</p></details></section>
  <script>
    type ImpactData = { coverageStartsAt?: string | null; totals?: Record<string, number>; corrections?: Record<string, number>; editorialOutcomes?: Array<{ outcome_type: string; public_note: string }>; requestedTopics?: Array<{ article_slug: string; count: number }>; unmatchedDemand?: number; externalCitations?: Array<{ title: string; publisher: string; url: string; cited_at?: string | null }>; message?: string };
    const root = document.querySelector<HTMLElement>("[data-impact-live]"); const actions = document.querySelector<HTMLElement>("[data-impact-actions]"); const coverage = document.querySelector<HTMLElement>("[data-impact-coverage]"); const corrections = document.querySelector<HTMLElement>("[data-impact-corrections]"); const outcomes = document.querySelector<HTMLElement>("[data-impact-outcomes]"); const topics = document.querySelector<HTMLElement>("[data-impact-topics]"); const unmatched = document.querySelector<HTMLElement>("[data-impact-unmatched]"); const citations = document.querySelector<HTMLElement>("[data-impact-citations]");
    const append = <K extends keyof HTMLElementTagNameMap>(parent: HTMLElement | null, tag: K, text: string) => { const element = document.createElement(tag); element.textContent = text; parent?.append(element); return element; };
    fetch("/api/impact/summary").then(async (response) => { const data = await response.json() as ImpactData; if (!response.ok) throw new Error(data.message || "Live impact aggregates are temporarily unavailable."); return data; }).then((data: ImpactData) => {
      if (coverage) coverage.textContent = data.coverageStartsAt ? `Coverage began ${data.coverageStartsAt}` : "No live actions recorded yet";
      if (actions) { actions.replaceChildren(); [["data_download","data downloads"],["card_download","card downloads"],["embed_view","card embeds"],["ask_match","matched lookups"],["ask_no_match","unmatched demand"]].forEach(([key,label]) => { const card=document.createElement("article"); append(card,"strong",String(data.totals?.[key] ?? 0)); append(card,"span",label); actions.append(card); }); }
      if (corrections) { corrections.replaceChildren(); [["open","open"],["accepted","accepted"],["resolved","resolved"],["rejected","rejected"]].forEach(([key,label]) => { const row=document.createElement("div"); append(row,"dt",label); append(row,"dd",String(data.corrections?.[key] ?? 0)); corrections.append(row); }); }
      if (outcomes) { outcomes.replaceChildren(); (data.editorialOutcomes ?? []).forEach((item) => append(outcomes,"li",`${item.outcome_type.replaceAll("_"," ")}: ${item.public_note}`)); if (!outcomes.childElementCount) append(outcomes,"li","No public editorial outcomes recorded yet."); }
      if (topics) { topics.replaceChildren(); (data.requestedTopics ?? []).forEach((item) => { const li=append(topics,"li",""); append(li,"span",item.article_slug); append(li,"strong",String(item.count)); }); if (!topics.childElementCount) append(topics,"li","No matched lookup demand recorded yet."); }
      if (unmatched) unmatched.textContent = `${data.unmatchedDemand ?? 0} unmatched claim request${data.unmatchedDemand === 1 ? "" : "s"} recorded in aggregate.`;
      if (citations) { citations.replaceChildren(); (data.externalCitations ?? []).forEach((item) => { const link=document.createElement("a"); link.className="search-result"; link.href=item.url; link.target="_blank"; link.rel="noopener noreferrer"; append(link,"h3",item.title); append(link,"p",`${item.publisher}${item.cited_at ? ` · ${item.cited_at}` : ""}`); citations.append(link); }); if (!citations.childElementCount) append(citations,"p","No verified external citations have been published yet.").className="empty-state"; }
    }).catch((error) => { if (coverage) coverage.textContent = error instanceof Error ? error.message : "Live impact aggregates are temporarily unavailable."; root?.classList.add("impact-live--unavailable"); });
  </script>
</BaseLayout>

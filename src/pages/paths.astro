---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getVisibleMyths } from "../lib/content";
const myths = await getVisibleMyths();
const paths = [
  { title:"Kazakhstan in 5 minutes", intro:"A compact route through statehood, language, geography and everyday life. Start here if you know nothing.", slugs:["part-of-russia","kazakh-and-russian","country-size","only-steppe","yurts","capital-astana"] },
  { title:"History and deep time", intro:"From the Kazakh Khanate and Silk Roads to Soviet nuclear testing and 1991 independence.", slugs:["kazakh-statehood","silk-roads","tomyris","nuclear-weapons","semipalatinsk-safe","part-of-russia"] },
  { title:"Culture without shortcuts", intro:"Separate food, religion, ethnicity, language and heritage from one-dimensional stereotypes.", slugs:["kazakh-and-russian","ethnic-diversity","secular-muslim","horse-meat-kumys","world-heritage","borat"] },
  { title:"Geography and nature", intro:"A country of 2.7 million km² — steppe, mountains, canyons, the Aral Sea, and four seasons.", slugs:["country-size","only-steppe","climate-seasons","aral-sea-gone","landlocked-isolated","charyn-canyon"] },
  { title:"Media literacy route", intro:"Viral claims, comedy, memes, AI errors and internet restrictions — how information shapes perception.", slugs:["borat","kazakhstan-memes","giant-door","internet-closed","ai-accuracy-kazakhstan"] },
  { title:"For the curious traveller", intro:"Safety, climate, capital city, earthquake risk, cultural expectations — practical context before you go.", slugs:["safety-tourism","capital-astana","climate-seasons","almaty-earthquake","horse-meat-kumys","bride-kidnapping"] },
  { title:"Science and discovery", intro:"Horse domestication, the apple’s wild ancestor, the Baikonur cosmodrome, and nuclear energy.", slugs:["horse-domestication","apple-origins","baikonur","nuclear-energy-weapons","latin-alphabet"] },
];
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Reading Paths — Qazaq Lens",
  "description": "Guided reading paths through evidence-checked explainers about Kazakhstan.",
  "url": "https://qazaqlens.org/paths/",
  "numberOfItems": paths.length,
  "itemListElement": paths.map((path, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": path.title,
    "description": path.intro,
    "url": `https://qazaqlens.org/paths/#path-${i + 1}`,
  })),
};
---
<BaseLayout title="Reading paths" description="Guided reading paths through Qazaq Lens explainers about Kazakhstan." jsonLd={jsonLd}>
  <div class="wrap-wide page-hero"><p class="eyebrow">Guided reading</p><h1>Choose a route, not a rabbit hole.</h1><p class="lead">Each path moves from a memorable shortcut to the evidence needed to complicate it.</p></div>
  <section class="wrap-wide path-grid">{paths.map((path,index)=><article class="path-card card"><span class="path-number">{String(index+1).padStart(2,"0")}</span><p class="eyebrow">{path.slugs.length} stops</p><h2>{path.title}</h2><p>{path.intro}</p><ol>{path.slugs.map((slug)=>{const myth=myths.find((m)=>m.data.slug===slug); return myth && <li><a href={`/myths/${slug}`}>{myth.data.title}</a></li>})}</ol></article>)}</section>
</BaseLayout>

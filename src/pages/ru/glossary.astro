---
import BaseLayout from "../../layouts/BaseLayout.astro";

const terms = [
  ["Қазақ / Казах", "Қазақ — самоназвание казахского народа и языка. «Казах» — общепринятая русская форма для обозначения языка и национальности; «казахстанец» обычно относится к гражданину или жителю Казахстана, независимо от этнической принадлежности."],
  ["Казахстанец", "Гражданский термин для людей, связанных с государством Казахстан. Не является синонимом этнического казаха: в Казахстане множество этнических общин и граждан разного происхождения."],
  ["Кымыз / Кумыс", "Кисломолочный напиток из кобыльего молока, занимающий важное место в казахских традициях коневодства и гостеприимства. Это культурное наследие, а не напиток, одинаково употребляемый каждым."],
  ["Юрта", "Переносное жилище, связанное с центральноазиатскими кочевыми традициями и признанное живым наследием. Современная жизнь в Казахстане преимущественно городская, а юрты используются в культурных, праздничных и практических целях."],
  ["Жуз", "Историческое социальное и генеалогическое объединение казахских общин. Не следует воспринимать как современную политическую партию, расу или жёсткую кастовую систему."],
  ["Область", "Крупная административная единица Казахстана, примерно соответствующая провинции. Границы и названия могут меняться; актуальные данные следует датировать."],
  ["Наурыз", "Весенний праздник, отмечаемый в Центральной Азии и других регионах. В Казахстане он сочетает сезонные, культурные и гражданские смыслы и не свидетельствует об одной единственной религиозной идентичности."],
  ["Аким / Акимат", "Аким — региональный или городской исполнительный чиновник; акимат — соответствующий местный исполнительный орган."],
  ["Байконур", "Название используется как для расположенного поблизости города, так и для крупного космического комплекса в Казахстане. Россия эксплуатирует комплекс по договору аренды; аренда не меняет географического положения объекта."],
  ["Средний коридор", "Транскаспийский международный транспортный маршрут, связывающий железные дороги, шоссейные магистрали и каспийские перевозки между Китаем, Центральной Азией, Кавказом и Европой."],
  ["Семипалатинск", "Бывший советский ядерный полигон и окружающий исторический регион. Его наследие занимает центральное место в казахских дискуссиях о разоружении и ядерной политике."],
  ["Аральское море", "Трансграничное внутреннее озеро, резко сократившееся в результате решений по управлению водными ресурсами. Северный Арал в Казахстане частично восстановился, тогда как в целом кризис продолжается."],
  ["Тенге", "Национальная валюта Казахстана, введённая в ноябре 1993 года, — отличается от российского рубля. Её существование является маркером монетарного суверенитета Казахстана. Код валюты — KZT."],
  ["Домбра", "Двухструнный щипковый инструмент, занимающий центральное место в казахской музыкальной традиции. Домбра используется как для инструментальных пьес (küй), так и для сопровождения эпической поэзии. Нередко называется национальным инструментом."],
  ["Күй (Кюй)", "Традиционная казахская инструментальная пьеса, как правило исполняемая на домбре. Кюи могут повествовать об исторических событиях или передавать эмоциональные пейзажи через сложную технику и мелодику."],
  ["Шанырак", "Круглое навершие-отверстие в верхней части юрты, пропускающее свет и позволяющее выходить дыму. Шанырак — значимый символ в казахской культуре и изображён на государственном гербе Казахстана."],
  ["Жырау", "Традиционный казахский поэт-певец и музыкант, сопоставимый с придворным бардом или гриотом в других культурах. Жырау сочиняли и исполняли эпическую поэзию верхом на лошади и на собраниях."],
  ["Астана", "Нынешняя столица Казахстана. Город стал столицей в 1997 году (перенос из Алматы) и носил несколько названий: Акмола (1994–1998), Астана (1998–2019), Нур-Султан (2019–2022) и снова Астана с 2022 года."],
  ["Евразийский экономический союз (ЕАЭС)", "Региональный блок экономической интеграции, включающий Россию, Казахстан, Беларусь, Армению и Кыргызстан. Членство создаёт обязательства по экономической координации, но не подчиняет государства-члены России."],
  ["Многовекторная внешняя политика", "Заявленный курс Казахстана в области внешних связей: поддержание сбалансированных независимых отношений с Россией, Китаем, Европейским союзом, США и другими партнёрами одновременно, без исключительной ориентации на кого-либо."],
  ["Казахское ханство", "Государство, основанное приблизительно в 1465 году ханами Жанибеком и Кереем, охватывавшее значительную часть современной казахстанской степи. Его существование предшествует российскому имперскому контакту и свидетельствует о прежней казахской государственности."],
  ["Тимуридская архитектура", "Архитектурная традиция, связанная с империей Тимура (Тамерлана) и его преемников, для которой характерны большие синие купола с плиточным декором, айваны и сложный геометрический орнамент. Мавзолей Ходжи Ахмеда Ясави в Туркестане — ключевой пример."],
  ["Полигон / Семипалатинский испытательный полигон", "Советский ядерный испытательный полигон на северо-востоке Казахстана, где с 1949 по 1989 год было проведено более 450 ядерных испытаний. Казахстан закрыл полигон после обретения независимости и является безъядерным государством."],
];
---
<BaseLayout lang="ru" title="Глоссарий" description="Понятный глоссарий для понимания Казахстана, его народа, истории и институтов.">
  <div class="wrap page-hero glossary-page">
    <p class="eyebrow">Контекст прежде выводов</p>
    <h1>Глоссарий</h1>
    <p class="lead">Термины, которые часто переводятся неточно, упрощаются или неправильно понимаются в разговорах о Казахстане.</p>
    <label class="glossary-search"><span>Поиск терминов</span><input type="search" data-glossary-search placeholder="Например: юрта, акимат, жуз…" /></label>
    <div class="glossary-grid" data-glossary-list>
      {terms.map(([term, definition]) => (
        <article class="glossary-card" data-glossary-card data-glossary-text={`${term} ${definition}`.toLowerCase()}>
          <h2>{term}</h2><p>{definition}</p>
        </article>
      ))}
    </div>
    <p class="empty-state" data-glossary-empty hidden>Нет совпадений. Попробуйте другое написание.</p>
  </div>
  <script>
    const input = document.querySelector<HTMLInputElement>("[data-glossary-search]");
    const cards = [...document.querySelectorAll<HTMLElement>("[data-glossary-card]")];
    const empty = document.querySelector<HTMLElement>("[data-glossary-empty]");
    input?.addEventListener("input", () => { const q = input.value.trim().toLowerCase(); let v = 0; cards.forEach((c) => { const show = !q || (c.dataset.glossaryText ?? "").includes(q); c.hidden = !show; if (show) v++; }); if (empty) empty.hidden = v > 0; });
  </script>
</BaseLayout>
<style>
  .glossary-search{display:grid;gap:.45rem;margin:2rem 0 1.5rem;max-width:680px;font:700 .72rem var(--font-mono);color:var(--muted)}
  .glossary-search input{border:1px solid var(--line);border-radius:var(--radius-sm);padding:1rem;background:var(--surface);color:var(--ink);font:1rem var(--font-display)}
  .glossary-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}
  .glossary-card{padding:1.4rem;border:1px solid var(--line);border-radius:var(--radius);background:var(--surface);transition:transform .25s ease,border-color .25s ease}
  .glossary-card:hover{transform:translateY(-3px);border-color:var(--brand)}.glossary-card h2{margin:0;font-size:1.25rem}.glossary-card p{color:var(--muted);margin-bottom:0}
  @media(max-width:720px){.glossary-grid{grid-template-columns:1fr}}
</style>
